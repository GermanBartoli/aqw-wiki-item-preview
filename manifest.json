{
  "manifest_version": 3,
  "name": "AQW Wiki Item Preview",
  "description": "Muestra la imagen de un objeto al pasar el mouse sobre su enlace en AQW Wiki.",
  "version": "1.0.0",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://aqwwiki.wikidot.com/*"],
      "js": ["src/core/item-page.js", "src/content/preview.js"],
      "css": ["src/content/preview.css"],
      "run_at": "document_idle"
    }
  ]
}
