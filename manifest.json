{
  "manifest_version": 3,
  "name": "AQW Wiki Item Preview",
  "description": "Muestra imágenes de objetos al pasar el mouse y en las tablas de AQW Wiki.",
  "version": "1.1.0",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://aqwwiki.wikidot.com/*"],
      "js": ["src/core/item-page.js", "src/content/item-loader.js", "src/content/preview.js", "src/content/table-preview.js"],
      "css": ["src/content/preview.css", "src/content/table-preview.css"],
      "run_at": "document_idle"
    }
  ]
}
